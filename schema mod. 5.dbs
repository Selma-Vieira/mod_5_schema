<?xml version="1.0" encoding="UTF-8" ?>
<project name="Dashboard de Vendas com Power BI utilizando Star Schema" database="MySql" id="6e7d0fe2-aa8d-462c-9410-c32fee0011cc" >
	<schema name="schema_dio" >
		<table name="aluno" prior="al" >
			<column name="idaluno" type="INT" mandatory="y" />
			<index name="pk_aluno" unique="PRIMARY_KEY" >
				<column name="idaluno" />
			</index>
			<fk name="fk_aluno_matriculado" to_schema="schema_dio" to_table="matriculado" >
				<fk_column name="idaluno" pk="aluno_idaluno" />
			</fk>
		</table>
		<table name="curso" prior="cur" >
			<column name="idcurso" type="INT" mandatory="y" />
			<column name="departamento_iddepartamento" type="INT" />
			<index name="pk_curso" unique="PRIMARY_KEY" >
				<column name="idcurso" />
			</index>
			<index name="unq_curso_departamento_iddepartamento" unique="UNIQUE_KEY" >
				<column name="departamento_iddepartamento" />
			</index>
			<fk name="fk_curso_curso" to_schema="schema_dio" to_table="curso" >
				<fk_column name="departamento_iddepartamento" pk="departamento_iddepartamento" />
			</fk>
			<fk name="fk_curso_disciplina &amp; curso" to_schema="schema_dio" to_table="disciplina &amp; curso" >
				<fk_column name="idcurso" pk="curso_idcurso" />
			</fk>
		</table>
		<table name="departamento" prior="departamen" >
			<column name="id_departamento" type="INT" mandatory="y" />
			<column name="nome" type="VARCHAR" length="45" />
			<column name="campus" type="VARCHAR" length="45" />
			<column name="idprofessor_coordenador" type="INT" mandatory="y" />
			<index name="pk_departamento" unique="PRIMARY_KEY" >
				<column name="id_departamento" />
			</index>
			<index name="unq_departamento_idprofessor_coordenador" unique="UNIQUE_KEY" >
				<column name="idprofessor_coordenador" />
			</index>
			<index name="unq_departamento_nome" unique="UNIQUE_KEY" >
				<column name="nome" />
			</index>
			<fk name="fk_departamento_curso" to_schema="schema_dio" to_table="curso" >
				<fk_column name="id_departamento" pk="departamento_iddepartamento" />
			</fk>
			<fk name="fk_departamento_aluno" to_schema="schema_dio" to_table="aluno" >
				<fk_column name="nome" pk="idaluno" />
			</fk>
			<fk name="fk_departamento_professor" to_schema="schema_dio" to_table="professor" >
				<fk_column name="idprofessor_coordenador" pk="idprofessor" />
			</fk>
			<fk name="fk_departamento_disciplina" to_schema="schema_dio" to_table="disciplina" >
				<fk_column name="idprofessor_coordenador" pk="professor_idprofessor" />
			</fk>
		</table>
		<table name="disciplina" prior="discipli" >
			<column name="id_disciplina" type="INT" mandatory="y" />
			<column name="professor_idprofessor" type="INT" mandatory="y" />
			<index name="pk_disciplina" unique="PRIMARY_KEY" >
				<column name="id_disciplina" />
			</index>
			<index name="unq_disciplina_professor_idprofessor" unique="UNIQUE_KEY" >
				<column name="professor_idprofessor" />
			</index>
			<fk name="fk_disciplina_disciplina &amp; curso" to_schema="schema_dio" to_table="disciplina &amp; curso" >
				<fk_column name="id_disciplina" pk="disciplina_iddisciplina" />
			</fk>
			<fk name="fk_disciplina_matriculado" to_schema="schema_dio" to_table="matriculado" >
				<fk_column name="id_disciplina" pk="disciplina_iddisciplina" />
			</fk>
			<fk name="fk_disciplina_pré-requisitos das disciplinas" to_schema="schema_dio" to_table="pré-requisitos das disciplinas" >
				<fk_column name="id_disciplina" pk="disciplina_iddisciplina" />
			</fk>
			<fk name="fk_disciplina_pré-requisitos das disciplinas_0" to_schema="schema_dio" to_table="pré-requisitos das disciplinas" >
				<fk_column name="professor_idprofessor" pk="pré-requisitos_prérequisitos" />
			</fk>
		</table>
		<table name="disciplina &amp; curso" prior="disciplina &amp; cur" >
			<column name="disciplina_iddisciplina" type="INT" mandatory="y" />
			<column name="curso_idcurso" type="INT" />
			<index name="pk_disciplina &amp; curso" unique="PRIMARY_KEY" >
				<column name="disciplina_iddisciplina" />
			</index>
			<index name="unq_disciplina &amp; curso_curso_idcurso" unique="UNIQUE_KEY" >
				<column name="curso_idcurso" />
			</index>
		</table>
		<table name="matriculado" prior="matriculad" >
			<column name="aluno_idaluno" type="INT" mandatory="y" />
			<column name="disciplina_iddisciplina" type="INT" />
			<index name="pk_matriculado" unique="PRIMARY_KEY" >
				<column name="aluno_idaluno" />
			</index>
			<index name="unq_matriculado_disciplina_iddisciplina" unique="UNIQUE_KEY" >
				<column name="disciplina_iddisciplina" />
			</index>
		</table>
		<table name="professor" prior="profes" >
			<column name="idprofessor" type="INT" mandatory="y" />
			<column name="dep_iddepartamento" type="INT" />
			<index name="pk_professor" unique="PRIMARY_KEY" >
				<column name="idprofessor" />
			</index>
		</table>
		<table name="pré-requisitos das disciplinas" prior="pré-requisitos das disciplina" >
			<column name="disciplina_iddisciplina" type="INT" mandatory="y" />
			<column name="pré-requisitos_prérequisitos" type="INT" />
			<index name="pk_pré-requisitos das disciplinas" unique="PRIMARY_KEY" >
				<column name="disciplina_iddisciplina" />
			</index>
			<index name="unq_pré-requisitos das disciplinas_pré-requisitos_prérequisitos" unique="UNIQUE_KEY" >
				<column name="pré-requisitos_prérequisitos" />
			</index>
		</table>
		<table name="pré_requisitos" prior="pré_requisit" >
			<column name="idpré-requisitos" type="INT" mandatory="y" />
			<index name="pk_pré_requisitos" unique="PRIMARY_KEY" >
				<column name="idpré-requisitos" />
			</index>
			<fk name="fk_pré_requisitos_pré-requisitos das disciplinas" to_schema="schema_dio" to_table="pré-requisitos das disciplinas" >
				<fk_column name="idpré-requisitos" pk="pré-requisitos_prérequisitos" />
			</fk>
		</table>
	</schema>
